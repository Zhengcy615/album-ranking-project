$(function() 
{
	$(".addAlbumTag").click(function(){	
		var element = $(this);
		var id=element.attr("id");
		var tag=$("#tag").val();
		if (tag != '') {
			if (tag.length > 1 && tag.length <= 35) {
				$("#add").hide();
				$("#adding").show();
				//use the $.post() method to call insert.php file.. this is the ajax request
				$.post('/scripts/addAlbumTag.php', {albumID: id, tag: tag},
				function(data){
					//document.getElementById("tagMessage").style.color = "green";
					//document.getElementById("tagMessage").innerHTML = '"' + tag + '" entered as tag';
					$("#adding").hide();
					$("#add").show();
					document.getElementById("tag").value = "";
					$("#tagMessage").html(data);
					$("#tagMessage").hide();
					$("#tagMessage").show(); 
				});
				return false;
			} else {
				document.getElementById("tagMessage").style.color = "red";
				document.getElementById("tagMessage").innerHTML = "Tag must be more than 1 character and no more than 35";
				return false;
		}
		} else {
			document.getElementById("tagMessage").style.color = "red";
			document.getElementById("tagMessage").innerHTML = "You didn't enter any text";
			return false;
		}

	});
});
