$(document).ready(function(){
//Get the input data using the post method when Push into mysql is clicked .. we pull it using the id fields of ID, Name and Email respectively...
	
$(function() 
{
$(".addSpinList").click(function(){	
	var element = $(this);
	var id=element.attr("id");
	
	//Get values of the input fields and store it into the variables.
		//use the $.post() method to call insert.php file.. this is the ajax request
		$.post('/scripts/addSpinList.php', {albumID: id},
		function(data){
		$("#addSpinList").hide();
		$("#removeSpinList").show(); //Fade in the data given by the insert.php file
		});
		return false;
	});
});

$(function() 
{
$(".removeSpinList").click(function(){	
	var element = $(this);
	var id=element.attr("id");
	
	//Get values of the input fields and store it into the variables.
		//use the $.post() method to call insert.php file.. this is the ajax request
		$.post('/scripts/removeSpinList.php', {albumID: id},
		function(data){
		$("#removeSpinList").hide();
		$("#addSpinList").show(); //Fade in the data given by the insert.php file
		});
		return false;
	});
});
$(function() 
{
	$(".insertRating").click(function(){	
		var element = $(this);
		var id=element.attr("id");
		var value=$("#value").val();
		
		if(!isNaN(value)){
			if (value<=100 && value>=0 && value != '') {
			$("#rate").hide();
			$("#rating").show();
			//use the $.post() method to call insert.php file.. this is the ajax request
			$.post('/scripts/insertRatingLarge.php', {albumID: id, value: value},
			function(data){
			$("#ratingBlock").html(data);
			$("#ratingBlock").hide();
			$("#ratingBlock").show(); 
			$("#notificationArea").hide(); 
			});
			return false;
			} else {
			$("#notificationArea").show();
			document.getElementById("notificationMessage").innerHTML = "Number must be between 0-100";
			document.getElementById("notificationArea").classList.add('red');
			return false;
			}
		} else {
			$("#notificationArea").show(); 
			document.getElementById("notificationMessage").innerHTML = "Please enter a number";
			document.getElementById("notificationArea").classList.add('red');
			return false;
		}
	});
});
$(function() 
{
	$(".insertReview").click(function(){	
		var element = $(this);
		var id=element.attr("id");
		var text=$.trim($("#text").val());
		if (text != ''  && text != 'Add a Review') {
			if (text.length >= 3) {
				document.getElementById("notificationMessage").innerHTML = "";
				$("#post").hide();
				$("#posting").show();
				//use the $.post() method to call insert.php file.. this is the ajax request
				$.post('/scripts/insertReview.php', {albumID: id, text: text},
				function(data){
				$("#reviewBlock").html(data);
				$("#reviewBlock").hide();
				$("#reviewBlock").show(); 
				$("#postReviewButton").hide();	
				$("#notificationArea").hide(); 
				});
				return false;
			} else {
				$("#notificationArea").show(); 
				document.getElementById("notificationMessage").innerHTML = "You did not enter enough text";
				document.getElementById("notificationArea").classList.add('red');
				return false;
		}
		} else {
			$("#notificationArea").show(); 
			document.getElementById("notificationMessage").innerHTML = "Please enter some text";
			document.getElementById("notificationArea").classList.add('red');
			return false;
		}

	});
});
$(function() 
{
	$(".editReview").click(function(){	
		var element = $(this);
		var id=element.attr("id");
		$("#currentReviewBlock").hide();
		$("#editReviewButton").show();
			$.post('/scripts/editReview.php', {albumID: id},
			function(data){
				$("#editReviewBlock").html(data);
				$("#editReviewBlock").hide();
				$("#editReviewBlock").show(); 
			});
			return false;

	});
});
$(function() 
{
	$(".cancelUpdate").click(function(){	
		$("#currentReviewBlock").show();
		$("#editReviewButton").show();
		$("#deleteReviewButton").show();
		$("#updateButtons").hide();
		document.getElementById("editReviewBlock").innerHTML = "";
		return false;

	});
});
$(function() 
{
	$(".updateReview").click(function(){	
		var element = $(this);
		var id=element.attr("id");
		var text=$("#updateText").val();
		if (text != ''  && text != 'Add a Review') {
			if (text.length > 3) {
				$("#update").hide();
				$("#updating").show();
				//use the $.post() method to call insert.php file.. this is the ajax request
				$.post('/scripts/updateReview.php', {albumID: id, text: text},
				function(data){
				$("#updateButtons").hide();
				$("#editReviewBlock").hide();
				$("#reviewBlock").html(data);
				$("#reviewBlock").hide();
				$("#reviewBlock").show(); 
				});
				return false;
			} else {
				document.getElementById("editReviewMessage").innerHTML = "You did not enter enough text";
				return false;
		}
		} else {
			document.getElementById("editReviewMessage").innerHTML = "Please enter some text";
			return false;
		}

	});
});
