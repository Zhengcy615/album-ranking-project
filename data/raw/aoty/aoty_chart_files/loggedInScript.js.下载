$("body").on("click", ".editUsername", function(){	
	var element = $(this);
	var newUserName = document.getElementById('newUserName').value.trim();
	var printError = document.getElementById('error');
	var container = $(".overlay");
	const nameCheck = /^[a-zA-Z0-9_]+$/;
	var specialChars = nameCheck.test(newUserName);
	if (newUserName === '') {
		printError.innerHTML = "Must include at least one letter or number";
	} else if (newUserName.length > 15) {
		printError.innerHTML = "Too Long";
	} else if (!specialChars) {
		printError.innerHTML = "Please use alphanumeric characters only [A-Z], [0-9]. No spaces allowed.";
	} else {
		$.post('/scripts/editUsername.php', {newUserName: newUserName}, 
		function(data){
			if (data == 'Bad Username') {
				printError.innerHTML = "Bad Username.";
			} else {
				container.hide();
				document.getElementById('username').innerHTML = newUserName;
			}
		});
		
	}
	return false;
});
