// Genre Vote
$('.overlay').on('click', '.genreVoteFor, .genreVoteAgainst, .genreVoteRemove', function() {
    const btn     = $(this);
    const albumID = btn.data('album-id');
    const genreID = btn.data('genre-id');
    const type    = btn.data('type');

    const action = btn.hasClass('genreVoteFor')     ? 'for'
                 : btn.hasClass('genreVoteAgainst') ? 'against'
                 : 'remove';

    btn.prop('disabled', true);

    $.post('/scripts/genreVote.php', { albumID, genreID, type, action }, null, 'json')
        .done(function(data) {
            if (!data.success) return;

            const voteButtons = btn.closest('.voteButtons').length 
				? btn.closest('.voteButtons')
				: btn.closest('.overlay').find('[data-genre-id="' + genreID + '"]').closest('.voteButtons').first();
			const forBtn      = voteButtons.find('button').first();
			const againstBtn  = voteButtons.find('button').last();

            forBtn.next('.voteCount').text(data.voteFor || '');
            againstBtn.next('.voteCount').text(data.voteAgainst || '');

            forBtn.removeClass('genreVoteFor genreVoteRemove')
                  .addClass(data.myVote == 1 ? 'genreVoteRemove' : 'genreVoteFor')
                  .find('i').toggleClass('activeVoteFor', data.myVote == 1);

            againstBtn.removeClass('genreVoteAgainst genreVoteRemove')
                      .addClass(data.myVote == -1 ? 'genreVoteRemove' : 'genreVoteAgainst')
                      .find('i').toggleClass('activeVoteAgainst', data.myVote == -1);
			$.post('/scripts/getUserGenreSuggestions.php', { albumID, type })
			.done(function(html) {
				$('#yourSuggestions').html(html);
			});
        })
        .always(function() { btn.prop('disabled', false); });

    return false;
});

