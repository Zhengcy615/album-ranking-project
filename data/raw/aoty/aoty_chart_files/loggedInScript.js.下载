$(document).on("focus", "#label", function(e){
    $(this).autocomplete({
        source: "/scripts/labelAutocomplete.php",
        minLength: 1,
        select: function(event, ui) {
			var searchTerm = ui.item.value;
			var labelID = ui.item.id;
			document.getElementById('labelID').value = labelID;
        },
 
        html: false, // optional (jquery.ui.autocomplete.html.js required)
 
      // optional (if other layers overlap autocomplete list)
        open: function(event, ui) {
            $(".ui-autocomplete").css("z-index", 999999999999);	
			$(".ui-autocomplete li").css({fontSize: '14px'});			

        }
    }).data( "ui-autocomplete" )._renderItem = function( ul, item ) {
		$('.ui-autocomplete').addClass('autoOverlay');
		var term = this.term;
		var regex = new RegExp("(?![^&;]+;)(?!<[^<>]*)(" + $.ui.autocomplete.escapeRegex(term) + ")(?![^<>]*>)(?![^&;]+;)", "gi");

		var value = item.value.replace(regex, "<strong>$1</strong>");
        var inner_html = value + item.descriptor + '<div style="position:absolute; right:15px; top: 4px; font-size: 12px;"><a style="cursor:pointer;" href="' + item.link + '" target="_blank" onclick="event.stopPropagation();"><i class="fa-light fa-arrow-up-right-from-square"></i></a></div>';
        return $( "<li></li>" )
                .data( "item.autocomplete", item )
				.css({position: "relative", paddingRight: "24px"})
                .append(inner_html)
                .appendTo( ul );
	}; 
});
