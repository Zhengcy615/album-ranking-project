$(document).ready(function(){
// Main Search Autocomplete
$(function () {
 
    // ==================== IN-MEMORY CACHE ====================
    // Simple session cache — no localStorage I/O, zero INP impact
    var searchCache = {};
 
    // ==================== AUTOCOMPLETE ====================
    $.ui.autocomplete.prototype._resizeMenu = function () {
        this.menu.element.outerWidth(this.element.outerWidth());
    };
 
    // Pre-build the "See All Results" li once and clone it on open
    var $seeAllTemplate = $('<li class="ui-menu-item seeAllResults"></li>')
        .append('<a href="#"><strong>See All Results <i class="far fa-chevron-double-right fa-xs"></i></strong></a>');
 
    $("#searchT").autocomplete({
        source: function (request, response) {
            var term = request.term.toLowerCase().trim();
 
            // Return cached result if available
            if (searchCache[term]) {
                response(searchCache[term]);
                return;
            }
 
            $.ajax({
                url: "/search-autocomplete.php",
                data: { term: term },
                dataType: "json",
                success: function (data) {
                    searchCache[term] = data;
                    response(data);
                },
                error: function () {
                    response([]);
                }
            });
        },
        delay: 300,
        minLength: 3,
        appendTo: '#searchSuggestions',
 
        select: function (event, ui) {
            if (ui.item.link) {
                location.href = ui.item.link;
            }
            return false;
        },
 
        open: function () {
            var $autocomplete = $(".ui-autocomplete");
            $autocomplete.css("z-index", 1000);
 
            if ($autocomplete.find('.seeAllResults').length === 0) {
                var $link = $seeAllTemplate.clone();
                $link.find('a').attr('href', '/search/?q=' + encodeURIComponent(this.value));
                $autocomplete.append($link);
            }
        }
 
    }).data("ui-autocomplete")._renderItem = function (ul, item) {
        var row = document.createElement('div');
        row.className = 'resultRow';
        row.innerHTML = item.image; // image HTML is trusted server output
 
        var artist = document.createElement('div');
        artist.textContent = item.artist || '';
 
        var album = document.createElement('div');
        album.textContent = item.album || '';
 
        var year = document.createElement('div');
        year.className = 'year';
        year.textContent = item.year || '';
 
        row.appendChild(artist);
        row.appendChild(album);
        row.appendChild(year);
 
        return $("<li></li>")
            .data("item.autocomplete", item)
            .append(row)
            .appendTo(ul);
    };
 
});
