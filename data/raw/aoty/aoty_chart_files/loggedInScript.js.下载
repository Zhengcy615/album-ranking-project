// Insert Track Ratings
$('.overlay').on("click", ".insertTrackRatings", function(){
	var container = $(".inner");
	var element = $(this);
	var numTracks = element.attr("data-number-tracks");	
	var albumID = $("#albumID").attr("data-album-id");

	for (var i=1; i <= numTracks; i++) {
		var value = document.getElementById("track_"+i).value; 
		var songID = $("#track_"+i).attr("data-song-id");
		var prevScore = $("#track_"+i).attr("data-prev-value");
		var ratingID = $("#track_"+i).attr("data-rating-id");
		var msg = document.getElementById("track_"+songID+"_msg");
		if(!isNaN(value)){
			if ((value<=100 && value>=0 && value != '') || (ratingID != null && value<=100 && value>=0)) {
				var curTrack = document.getElementById("track_"+i);
				if (prevScore != value){ 					
					if (curTrack.value !== '') {
						curTrack.placeholder = curTrack.value;
					} else {
						curTrack.placeholder = 'NR';
					}					
					curTrack.setAttribute('data-rating-id', '');
					curTrack.setAttribute('data-prev-value', '');
					curTrack.value = '';
					curTrack.defaultValue = '';
					curTrack.readOnly = true;
					msg.style.display = "block";
					$.post('/scripts/insertSongRating.php', {songID: songID, value: value, prevScore: prevScore, ratingID: ratingID},
					function(data){
						document.getElementById("track_"+data+"_msg").style = "color: green;";
						document.getElementById("track_"+data+"_msg").innerHTML = "Updated";
					});
				}
			}

		}
	}
	$('.overlay input[type="text"]').each(function(){
		$(this).data('original-value', $(this).val().trim());
	});
	return false;
});
