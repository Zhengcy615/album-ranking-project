// Hide For You on Homepage
$('body').on("click", ".hideForYou", function(){	
    var now = new Date();
    var day = now.getUTCDay();
    var daysUntilFriday = (5 - day + 7) % 7 || 7;
    var nextFriday = new Date(now.getTime() + daysUntilFriday * 24 * 60 * 60 * 1000);
    nextFriday.setUTCHours(6, 0, 0, 0);
    
    document.cookie = 'hideForYou=1; path=/; expires=' + nextFriday.toUTCString();
    
    $('#forYouSection').slideUp();
});
