// Change Distribution
$('body').on("click", ".changeDistribution", function(){
	var element = $(this);
	var type = element.attr("data-type");
	var format = element.attr("data-format");
	var itemID = element.attr("data-item-id");
	var container = $("#ratingDistribution");
	var toggleConfig = {
		'profile-singles': { newFormat: 'videos', label: 'Singles', flipIcon: true },
		'profile-videos': { newFormat: 'tracks', label: 'Videos', flipIcon: false },
		'profile-tracks': { newFormat: 'albums', label: 'Tracks', flipIcon: true },
		'profile-albums': { newFormat: 'singles', label: 'Albums', flipIcon: false },
		'album-following': { newFormat: 'all', label: 'Following', flipIcon: true },
		'album-all': { newFormat: 'following', label: 'All', flipIcon: false }
	};
	
	$.post('/scripts/changeDistribution.php', {type: type, format: format, itemID: itemID}, 
	function(data){
		var key = type + '-' + format;
		var config = toggleConfig[key];
		
		if (config) {
			var iconClass = config.flipIcon ? 'fa-sync fa-flip-horizontal' : 'fa-sync';
			document.getElementById("changeDistribution").innerHTML = 
				"<button class=\"changeDistribution\" data-type=\"" + type + "\" data-format=\"" + config.newFormat + "\" data-item-id=\"" + itemID + "\">" + 
				config.label + " <span id=\"changeDistIcon\"><i class=\"fas " + iconClass + "\"></i></span></button>";
		}
		container.html(data);
	});
	return false;
});
