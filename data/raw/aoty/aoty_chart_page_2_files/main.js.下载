// Random Genre Search
var genreFields = {
    '#randomGenreSearch': '#randomGenreID',
    '#randomSecondaryGenreSearch': '#randomSecondaryGenreID'
};
$.each(genreFields, function(searchSelector, idSelector) {
    $('.overlay').on('focus', searchSelector, function() {
        $(this).autocomplete({
            source: '/scripts/albumGenreAutocomplete.php',
            minLength: 3,
            select: function(event, ui) {
                $(searchSelector).val(ui.item.value);
                $(idSelector).val(ui.item.id);
                buildRandomUrl();
                return false;
            },
            open: function() {
                $(".ui-autocomplete").css("z-index", 999999999999);
            }
        });
    });
    $('.overlay').on('input', searchSelector, function() {
        if ($(this).val() === '') {
            $(idSelector).val('');
            buildRandomUrl();
        }
    });
});