// Close Overlay
$('.overlay').on("click", ".overlayClose", function(){
	var container = $(".overlay");
	container.html('');
	$(".overlay").removeClass("show");
	return false;
});
const overlay = document.querySelector(".overlay");
overlay.addEventListener("click", (e) => {
  // Check if user has selected text
  const selection = window.getSelection();
  const hasTextSelected = selection && selection.toString().length > 0;
  if (hasTextSelected) {
    // User dragged to select text — don't close the overlay
    return;
  }
  // Only close if they clicked the backdrop itself
  if (e.target === overlay) {
	var hasUnsaved = false;
	$('.overlay input[type="text"], .overlay input[type="search"], .overlay textarea').each(function(){
		var original = $(this).data('original-value');
        var current = $(this).val().trim();
		if (original !== undefined) {
			if (current !== String(original)) hasUnsaved = true;
		} else {
			if (current !== '') hasUnsaved = true;
		}
	});

	if (hasUnsaved && !confirm("You have unsaved changes. Close anyway?")) {
		return;
	}
    const container = $(".overlay");
    container.html('');
    container.removeClass("show");
  }
});
