// Show Random Filters
$("body").on("click", ".randomFilters", function(){
	if (document.getElementById("header").classList.contains('navOpen')) {
        changeClass();
    }
    var element = $(this);
    var params = element.data('params') || {};
    var container = $(".overlay");
    container.html('');
    $.get('/scripts/randomFilters.php', function(data){
        container.html(data);
        var filterMap = {
			type: '#randomType',
			yearFrom: '#randomYearFrom',
			yearTo: '#randomYearTo',
			criticScoreMin: '#randomCriticScoreMin',
			criticScoreMax: '#randomCriticScoreMax',
			userScoreMin: '#randomUserScoreMin',
			userScoreMax: '#randomUserScoreMax',
			criticReviewsMin: '#randomCriticReviewsMin',
			criticReviewsMax: '#randomCriticReviewsMax',
			userReviewsMin: '#randomUserReviewsMin',
			userReviewsMax: '#randomUserReviewsMax'
		};
        $.each(filterMap, function(key, selector) {
			if (params[key] !== undefined && params[key] !== null && params[key] !== '') {
				$(selector).val(params[key]);
			}
		});
        if (params.genre) {
            $('#randomGenreID').val(params.genre);
            $.get('/scripts/getGenreName.php', {id: params.genre}, function(name) {
                $('#randomGenreSearch').val(name);
            });
        }
		if (params.genreSecondary) {
			$('#randomSecondaryGenreID').val(params.genreSecondary);
			$.get('/scripts/getGenreName.php', {id: params.genreSecondary}, function(name) {
				$('#randomSecondaryGenreSearch').val(name);
			});
		}
        buildRandomUrl();
    });
    $(".overlay").addClass("show");
    return false;
});
// Random Release Filters
function buildRandomUrl() {
    var params = new URLSearchParams();

    var type = $('#randomType').val();
    if (type) params.append('type', type);

    var yearFrom = $('#randomYearFrom').val();
    var yearTo = $('#randomYearTo').val();
    if (yearFrom) params.append('yearFrom', yearFrom);
    if (yearTo) params.append('yearTo', yearTo);

    var genreID = $('#randomGenreID').val();
    if (genreID) params.append('genre', genreID);

    var genreSecondaryID = $('#randomSecondaryGenreID').val();
    if (genreSecondaryID) params.append('genreSecondary', genreSecondaryID);

    var criticScoreMin = $('#randomCriticScoreMin').val();
    var criticScoreMax = $('#randomCriticScoreMax').val();
    if (criticScoreMin !== '') params.append('criticScoreMin', criticScoreMin);
    if (criticScoreMax !== '') params.append('criticScoreMax', criticScoreMax);

    var userScoreMin = $('#randomUserScoreMin').val();
    var userScoreMax = $('#randomUserScoreMax').val();
    if (userScoreMin !== '') params.append('userScoreMin', userScoreMin);
    if (userScoreMax !== '') params.append('userScoreMax', userScoreMax);

    var criticReviewsMin = $('#randomCriticReviewsMin').val();
    var criticReviewsMax = $('#randomCriticReviewsMax').val();
    if (criticReviewsMin !== '') params.append('criticReviewsMin', criticReviewsMin);
    if (criticReviewsMax !== '') params.append('criticReviewsMax', criticReviewsMax);

    var userReviewsMin = $('#randomUserReviewsMin').val();
    var userReviewsMax = $('#randomUserReviewsMax').val();
    if (userReviewsMin !== '') params.append('userReviewsMin', userReviewsMin);
    if (userReviewsMax !== '') params.append('userReviewsMax', userReviewsMax);

    var url = '/random/';
    if (params.toString()) url += '?' + params.toString();
    $('.surpriseMe').attr('href', url);
}

$('.overlay').on('change input', '#randomType, #randomYearFrom, #randomYearTo, #randomCriticScoreMin, #randomCriticScoreMax, #randomUserScoreMin, #randomUserScoreMax, #randomCriticReviewsMin, #randomCriticReviewsMax, #randomUserReviewsMin, #randomUserReviewsMax', function() {
    buildRandomUrl();
});
